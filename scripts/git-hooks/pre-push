#!/usr/bin/env bash
#
# RollbackIQ pre-push hook: last local backstop against AI attribution footers.
# Scans every commit message in the ranges being pushed, so a footer that got in
# through `git commit --no-verify` still cannot reach a remote (AGENTS.md
# section 10).
set -uo pipefail

root="$(git rev-parse --show-toplevel)"
guard="$root/scripts/check_no_attribution.sh"
zero="0000000000000000000000000000000000000000"
status=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ -n "${local_sha:-}" ] || continue
  [ "$local_sha" = "$zero" ] && continue   # branch deletion: nothing to scan
  remote_sha="${remote_sha:-$zero}"

  if [ "$remote_sha" = "$zero" ]; then
    # New remote branch: every commit it carries is new to that remote.
    range="$local_sha"
  elif git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
    range="$remote_sha..$local_sha"
  else
    # The remote tip does not exist in this repository, which happens on the
    # first push to an unrelated remote (a new project whose history we never
    # fetched). The old behaviour built an invalid range and aborted the push,
    # so scan everything reachable from the local tip instead: slower, but it
    # checks the commits being sent rather than refusing legitimate work.
    printf 'attribution guard: remote tip %s is not present locally; scanning every commit reachable from %s\n' \
      "$remote_sha" "$local_sha" >&2
    range="$local_sha"
  fi

  "$guard" range "$range" || status=1
done

exit "$status"
