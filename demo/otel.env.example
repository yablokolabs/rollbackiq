# Example environment for exporting real telemetry to GitLab Observability.
#
# Copy the values you need into your shell or a local .env (never commit a
# filled-in copy). The endpoint is not a secret; a token would be, and if your
# collector requires one, pass it as an OTLP header instead of hard-coding it:
#
#   OTEL_EXPORTER_OTLP_HEADERS="Authorization=Bearer <token>"
#
# The group id in the hostname is the hackathon workspace group id.

OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=https://144345494.otel.gitlab-o11y.com:14318
OTEL_SERVICE_NAME=rollbackiq-demo-workload

# GitLab's documented resource attributes, so traces link back to the project
# and the exact deployed commit. In CI these come from the predefined variables
# of the same name.
CI_PROJECT_ID=87424071
CI_PROJECT_NAME=rollbackiq
CI_COMMIT_SHA=local
CI_ENVIRONMENT_NAME=demo-staging
