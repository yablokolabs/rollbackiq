# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Node / frontend
node_modules/
dist/
.vite/

# Local environment and secrets (never commit credentials)
.env
.env.*
!.env.example

# Local runtime data
*.sqlite3
*.db

# Per-pipeline CI runtime state. The idempotency ledger records which keys a run
# consumed, so committing it would make a later pipeline refuse a fresh rollback.
evidence/rollback-state.json
evidence/**/state-*.json
evidence/**/*-state.json

# Vendored agent skills, fetched with `npx skills add <owner/repo>`. Deliberate:
# they are third-party tooling, not project source, and their bundled examples
# quote assistant names that the attribution guard correctly flags. Re-install
# per docs/diagrams/README.md; the diagrams themselves are committed.
.agents/skills/

# OS / editor
.DS_Store

# Installer artifacts from `npx skills add` (see .agents/skills/ above).
.claude/
skills-lock.json
