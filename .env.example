# Example environment for the RollbackIQ scripts.
#
# Copy to `.env` (gitignored) or export the values in your shell. Never commit a
# filled-in copy. The tests, the local lifecycle (`scripts/demo_lifecycle_local.sh`)
# and the incident console need none of these values.

# --- GitLab API ---------------------------------------------------------------
# Needed only by the scripts that call GitLab: duo_provision_catalog.py,
# duo_trigger_flow.py, capture_pipeline_evidence.py and gitlab_mcp_probe.py.
# The GitLab MCP server accepts only a token that has the `mcp` scope.
GITLAB_TOKEN=
GITLAB_URL=https://gitlab.com
GITLAB_PROJECT_ID=87424071

# --- Demo workload (set per deployment by scripts/ci_release.py) --------------
RELEASE_VERSION=v1
RELEASE_COMMIT_SHA=local
RELEASE_PIPELINE_ID=local
RELEASE_IMAGE_DIGEST=unknown
DEPLOY_ENV=demo-staging
# Fault inputs. A release is a set of deployment inputs on one image.
FAULT_LATENCY_MS=0
FAULT_ERROR_RATE=0

# --- Telemetry (optional; see demo/otel.env.example) --------------------------
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Local lifecycle overrides (scripts/demo_lifecycle_local.sh) --------------
# DEMO_IMAGE=rollbackiq-workload:local
# DEMO_NETWORK=rollbackiq-local
# DEMO_CONTAINER=rollbackiq-local-workload
# DEMO_WORKDIR=evidence/demo-run
# DEMO_ENVIRONMENT=demo-staging
# DEMO_APPROVER=
